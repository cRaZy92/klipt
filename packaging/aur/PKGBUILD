# Maintainer: Adam Šromovský
# Builds Klipt's desktop app from the repo. Install: makepkg -si (in this folder).
pkgname=klipt-desktop-git
pkgver=1.0.0
pkgrel=1
pkgdesc="Self-hosted Medal.tv alternative: save game clips with a hotkey and share them"
arch=('x86_64')
url="https://github.com/cRaZy92/klipt"
license=('custom')
depends=('gpu-screen-recorder' 'ffmpeg' 'webkit2gtk-4.1' 'libayatana-appindicator' 'gtk3')
makedepends=('git' 'rust' 'cargo' 'nodejs' 'pnpm')
provides=('klipt-desktop')
conflicts=('klipt-desktop')
options=('!lto' '!debug')
# KLIPT_REF picks what to build: update.sh sets it to the newest release (tag=vX.Y.Z).
source=("klipt::git+${url}.git#${KLIPT_REF:-branch=${KLIPT_BRANCH:-main}}")
sha256sums=('SKIP')

# The newest release tag's X.Y.Z; a build of later commits adds .r<commits since>.g<commit>
# (e.g. 1.2.0.r3.gabc1234), which pacman sorts after 1.2.0 and before 1.2.1.
pkgver() {
  cd klipt
  git describe --long --tags --match 'v[0-9]*.[0-9]*.[0-9]*' --abbrev=7 |
    sed 's/^v//; s/-0-g[0-9a-f]*$//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  cd klipt
  export CARGO_HOME="$srcdir/cargo-home"
  # Lets the app tell when a newer release is out (see desktop/src-tauri/src/update.rs).
  export KLIPT_COMMIT="$(git rev-parse HEAD)"
  pnpm install --frozen-lockfile
  cd desktop
  # The app shows (and reports) the package's version. Tauri wants semver, so commits past the
  # release go in build metadata: 1.2.0.r3.gabc1234 → 1.2.0+r3.gabc1234.
  local version
  version="$(printf %s "$pkgver" | sed 's/\.r/+r/')"
  pnpm tauri build --no-bundle --config "{\"version\":\"$version\"}"
}

package() {
  cd klipt
  install -Dm755 desktop/target/release/klipt-desktop "$pkgdir/usr/bin/klipt-desktop"
  # The file name is the app id KDE knows Klipt by (portal shortcuts, autostart). It must not end
  # in ".desktop" before the extension: KDE takes such ids for desktop files and never stores
  # their shortcuts. desktop/src-tauri/src/autostart_linux.rs uses the same name.
  install -Dm644 packaging/aur/app.klipt.Klipt.desktop "$pkgdir/usr/share/applications/app.klipt.Klipt.desktop"
  install -Dm644 desktop/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/app.klipt.desktop.png"
  install -Dm644 desktop/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/app.klipt.desktop.png"
  install -Dm644 desktop/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/app.klipt.desktop.png"
}
